# Copy to ".env" and fill in. On GitHub Actions use repository Secrets / Variables with the same names instead.
# Never commit a real .env file.

# --- ntfy (the only required setting) ----------------------------------------
# Anyone who knows a topic name can read AND post to it, so make it long and random
# (for example: loot-7f3k9q2xw8mz4t) and do not reuse one you have shared anywhere.
NTFY_TOPIC=
# Optional but recommended on GitHub Actions: an access token from your free ntfy account
# (ntfy.sh -> Account -> Access tokens). Without it ntfy counts your messages against the
# server's shared IP address, which other people's jobs can exhaust.
NTFY_TOKEN=
NTFY_SERVER=https://ntfy.sh
# Send "monitor is blind / started / still running" notes to a different topic (default: same topic).
NTFY_HEALTH_TOPIC=

# --- what counts as an alert ---------------------------------------------------
MIN_DISCOUNT=80            # percent off needed for any alert
URGENT_MIN_SAVING=2000     # ...it becomes the loud (max priority) alert when it saves this many rupees
URGENT_DISCOUNT=95         # ...or when it is at least this percent off, however small the amount
WATCH_DROP_PCT=50          # watchlist: percent drop against the product's own usual price
FLOOR_MRP_RATIO=4          # a new item under a page's floor counts only if its MRP is this many times the floor
MAX_POST_AGE_MIN=20        # ignore posts older than this (stale loots are already gone)
DEDUP_HOURS=12             # the same deal is not pushed again within this time, unless it gets cheaper
TRENDING_CHANNELS=3        # a quiet deal becomes urgent once this many channels post it...
TRENDING_WINDOW_MIN=20     # ...within this many minutes
DAILY_ALERT_LIMIT=200      # stay under ntfy.sh's free daily message allowance
# DENY_WORDS=quiz answers, refer and earn, demat, personal loan, rummy, betting, casino
# EXTRA_STORE_DOMAINS=shop-you-trust.in, another-shop.com

# --- pace and housekeeping --------------------------------------------------------
CHECK_INTERVAL=60          # seconds between scans
HEARTBEAT_HOUR=9           # daily "still running" note at this hour (India time); -1 to turn off
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid    # optional dead-man's switch (healthchecks.io, free)
# DB_PATH=lootwatch.db
# USE_CURL_CFFI=auto       # auto | on | off
# CURL_IMPERSONATE=chrome124   # browser profile curl_cffi presents to the stores
